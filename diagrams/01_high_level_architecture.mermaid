    end

    subgraph Server["RuralCare AI Express Backend & WebSockets"]
        S1["REST API Endpoints"]
        S2["WebRTC 2-Way Signaling Gateway"]
        S3["AI Provider Gateway (Grok & Gemini)"]
        S4["Smart Queue & Workload Engine"]
