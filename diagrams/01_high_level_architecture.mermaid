    end

    subgraph Doctor["Doctor Command Center Portal"]
        D1["Patient Approval Inbox & Mailbox"]
        D2["Priority Queue Dashboard"]
        D3["WebRTC HD Video Consultation"]
        D4["Remote Prescription & Medicine Vending Trigger"]
    end

    K1 --> S1
