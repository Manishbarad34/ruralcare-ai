# RuralCare AI SIH 2026 Environment Configuration (Safe Placeholders)

PORT=5000
NODE_ENV=development

# AI Provider Gateway Configuration (grok / gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# Speech & Translation Provider
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# PostgreSQL / JSON Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ruralcare_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_key_here

# Hardware Integration Simulation Modes
HARDWARE_MODE=simulation
DISPENSER_MODE=simulation
BLOOD_ANALYZER_MODE=simulation
FACE_RECOGNITION_PROVIDER=simulation

# Maps & Supplier API Integration
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
SUPPLIER_API_URL=https://api.medsupplier-example.com
